{
  "name": "sunday",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#config/*": "./config/*",
    "#lib/*": "./lib/*",
    "#services/*": "./services/*",
    "#assignor/*": "./assignor/*",
    "#issue/*": "./issue/*",
    "#pr/*": "./pr/*",
    "#scripts/*": "./scripts/*",
    "#boot.mts": "./boot.mts"
  },
  "description": "Orchestration workspace — labelled GitHub issues to sandboxed coding agents to PRs.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-console.mts",
    "test": "node test/run.mts",
    "sunday": "node --watch --env-file=.env main.mts",
    "run-one": "node --env-file=.env issue/run-one.mts",
    "repo:init": "bash scripts/repo-init.sh"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "typescript": "^5",
    "zod": "^4.4.3"
  }
}
