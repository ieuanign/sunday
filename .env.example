# Copy to .env and fill in. .env is gitignored — never commit secrets.

# --- Agent ---------------------------------------------------------------
# The coding agent Sunday runs in each sandbox. Default: claude.
# Swap here for another agent (e.g. chatgpt, gemini) — note it must be
# runnable headless inside the Docker sandbox, not just set here.
AGENT=claude

# Global fallback model + reasoning effort: the ORCHESTRATOR session's own
# model/effort, and what any phase degrades to when its matrix row is absent.
# Per-phase tuning lives in config/roster.json (Plan/Implement/Review/Debug/Sign-off),
# not in ten flat vars here.
MODEL=claude-opus-4-8
MODEL_EFFORT=high            # low | medium | high | xhigh | max

# A gated session only grows. Past this much context (input + cache reads +
# cache creation, in tokens) a human's reply does NOT resume it: one bounded turn
# compacts the session into a handoff note and a fresh session continues from it.
# Unset = 120000; 0 hands off on every gate reply. A value that isn't a token
# count fails the run — it never silently switches the handoff off.
HANDOFF_CTX_THRESHOLD=120000

# --- Agent auth ----------------------------------------------------------
# For Claude: a Max subscription token from `claude setup-token`
# ($0 marginal), or an API key. For another agent, replace with its auth var.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Pipeline ------------------------------------------------------------
# Local port the receiver takes forwarded GitHub events on. No public endpoint —
# `gh webhook forward --url http://localhost:<port>/` delivers here. Change it and
# process-compose.yaml's readiness probe port must change with it (it's a literal int).
SUNDAY_PORT=8787

# Global concurrency cap across ALL repos (one shared agent quota).
MAX_CONCURRENCY=3

# --- Telegram (optional) -------------------------------------------------
# Optional $0 phone channel — NO public endpoint, no tunnel. Both ways: Sunday
# sends notifications and polls the Bot API for commands (/status, /fix, /resume).
# Unset = disabled: notifications no-op, nothing polls, pipeline unchanged.
# Create a bot with @BotFather for the token; message the bot, then read your
# numeric chat id from https://api.telegram.org/bot<token>/getUpdates.
# The chat id is the ONLY authz: commands from any other chat are dropped, a token
# without one refuses to poll, and /fix starts an agent run on your quota.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
